# SMTP credentials used to send contact-form and newsletter notifications.
# Copy this file to ".env" and fill in real values once you have them.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# The inbox that should receive contact-form and newsletter notifications.
# You can set this to any address, even before you have SMTP credentials.
CONTACT_TO_EMAIL=
